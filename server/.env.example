# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# When local MongoDB is not running, server/db.js automatically falls back to an embedded in-memory MongoDB instance for seamless zero-config setup.
MONGODB_URI=mongodb://127.0.0.1:27017/hireverse

# Authentication
JWT_SECRET=hireverse_jwt_dev_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173
