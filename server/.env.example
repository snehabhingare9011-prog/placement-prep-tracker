# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas Cloud Database)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials:
# Ensure you configure your Atlas Database User (Security -> Database Access)
# and whitelist your IP or allow all (0.0.0.0/0) in Security -> Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/hireverse?retryWrites=true&w=majority

# Authentication
JWT_SECRET=hireverse_jwt_dev_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173

